# ── Required in production ─────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_ID=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_EMAIL=admin@africanadmission.org

# Attach a Railway volume and point this at its mount path so data + uploads survive redeploys
DATA_DIR=/data

# Public URL (used in password-reset links)
SITE_URL=https://your-app.up.railway.app

# Bank details shown to members when they make a contribution
BANK_NAME=
BANK_ACCOUNT_NAME=African Admission
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=

# Optional
ENROLLMENT_NOTICE=Enrollment for Grade 2-7 and 9-12: Confirm acceptance of placements between 17 September - 30 September 2025
CORS_ORIGIN=*
